# Lennard-Jones fluid at density 0.8442 held at temperature T: one point of
# the equation of state the agents measure.
# Usage: lmp -in in.lj-eos -var T 1.0 -var steps 4000

variable        T index 1.0
variable        steps index 4000

units           lj
atom_style      atomic

lattice         fcc 0.8442
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create ${T} 87287 loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 20 check no

fix             1 all nvt temp ${T} ${T} 0.5

thermo          100
thermo_style    custom step temp pe press
run             ${steps}
